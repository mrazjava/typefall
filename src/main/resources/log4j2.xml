<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Properties>
    <Property name="LOG_PATTERN"
      value="%d{yyyy-MM-dd'T'HH:mm:ss} %-30C{1.} %-5p %m%n" />
    <Property name="LOG_DIR" value="logs" />
  </Properties>
  <Appenders>
    <Console name="console" target="SYSTEM_OUT" follow="true">
      <PatternLayout pattern="${LOG_PATTERN}" />
    </Console>
    <RollingFile name="roll-by-size" fileName="${LOG_DIR}/application.log"
      filePattern="${LOG_DIR}/archived/%d{yyyy-MM-dd}.log.gz" createOnDemand="true"
      ignoreExceptions="false">
      <PatternLayout pattern="${LOG_PATTERN}" />
      <DefaultRolloverStrategy max="5" />
      <Policies>
        <!-- <SizeBasedTriggeringPolicy size="19500KB" />-->
        <TimeBasedTriggeringPolicy interval="1" modulate="true" />
      </Policies>

    </RollingFile>
  </Appenders>
  <Loggers>
    <Logger name="com.mrazjava" level="DEBUG" additivity="false">
      <AppenderRef ref="roll-by-size" />
    </Logger>
<!--    <Logger name="org.springframework.boot.autoconfigure" level="INFO">-->
<!--      <AppenderRef ref="roll-by-size" />-->
<!--    </Logger>-->
    <Root level="INFO">
      <!-- <AppenderRef ref="console" />-->
      <AppenderRef ref="roll-by-size" />
    </Root>
  </Loggers>
</Configuration>